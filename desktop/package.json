{
  "name": "blindside-dynasty-desktop",
  "version": "1.1.0",
  "description": "Blindside Dynasty \u2014 The Tactical Dynasty War Room Desktop Application",
  "main": "main.js",
  "author": "Kind of a Big Dill LLC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "world.kindofabigdill.blindsidedynasty.desktop",
    "productName": "Blindside Dynasty",
    "copyright": "Copyright \u00a9 2026 Kind of a Big Dill LLC",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blindside Dynasty"
    },
    "files": [
      "main.js",
      "icon.png",
      "icon.ico",
      "out/**/*"
    ]
  },
  "dependencies": {
    "serve-handler": "^6.1.6"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}